# === Hub 基础配置 ===
HUB_HOST=0.0.0.0
HUB_PORT=8000

# === LLM 配置 (支持 OpenAI / DeepSeek / 通义千问 / 本地 Ollama) ===
# 示例 1 (DeepSeek): LLM_BASE_URL=https://api.deepseek.com/v1  LLM_MODEL=deepseek-chat
# 示例 2 (本地 Ollama): LLM_BASE_URL=http://127.0.0.1:11434/v1  LLM_API_KEY=ollama  LLM_MODEL=qwen2.5:7b
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# === HomePod & TTS 配置 ===
# 可选：指定默认 HomePod 名称（留空则自动使用发现的第一台）
HOMEPOD_DEFAULT_NAME=
# Edge-TTS 语音角色，推荐 zh-CN-XiaoxiaoNeural 或 zh-CN-YunxiNeural
TTS_VOICE=zh-CN-XiaoxiaoNeural

# === Home Assistant 适配器配置 ===
# mock: 使用内置虚拟灯光/空调；real: 连接真实 Home Assistant
HA_MODE=mock
HA_URL=http://127.0.0.1:8123
HA_TOKEN=
